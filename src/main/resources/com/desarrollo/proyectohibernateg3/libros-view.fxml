<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600.0" prefWidth="760.0" spacing="12.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.desarrollo.proyectohibernateg3.controller.LibroController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Registro de libros" />

    <GridPane hgap="10.0" vgap="10.0">
        <Label text="Título:" GridPane.columnIndex="0" GridPane.rowIndex="0" />

        <TextField fx:id="txtTitulo" prefWidth="220.0" promptText="Título del libro" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Autor:" GridPane.columnIndex="0" GridPane.rowIndex="1" />

        <TextField fx:id="txtAutor" promptText="Autor del libro" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Año:" GridPane.columnIndex="0" GridPane.rowIndex="2" />

        <TextField fx:id="txtAnio" promptText="Año de publicación" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Precio:" GridPane.columnIndex="0" GridPane.rowIndex="3" />

        <TextField fx:id="txtPrecio" promptText="Precio del libro" GridPane.columnIndex="1" GridPane.rowIndex="3" />
        <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>
    </GridPane>

    <HBox spacing="10.0">
        <Button onAction="#guardarLibro" text="Guardar libro" />

        <Button onAction="#cargarLibros" text="Cargar libros" />
        <Button fx:id="btnModificar" mnemonicParsing="false" onAction="#modificarLibro" text="Modificar Libro" />
        <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarLibro" text="Eliminar Libro" />
        <Button mnemonicParsing="false" text="Limpiar Campos" />
    </HBox>

    <TableView fx:id="tablaLibros" prefHeight="350.0" VBox.vgrow="ALWAYS">

        <placeholder>
            <Label text="Tabla sin contenido" />
        </placeholder>

        <columns>
            <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />

            <TableColumn fx:id="colTitulo" prefWidth="240.0" text="Título" />

            <TableColumn fx:id="colAutor" prefWidth="220.0" text="Autor" />

            <TableColumn fx:id="colAnio" prefWidth="90.0" text="Año" />

            <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
        </columns>
    </TableView>

</VBox>