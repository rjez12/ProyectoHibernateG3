<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.desarrollo.proyectohibernateg3.controller.LibroController"
      prefWidth="760.0"
      prefHeight="600.0"
      spacing="12.0">

    <padding>
        <Insets top="20.0" right="20.0"
                bottom="20.0" left="20.0"/>
    </padding>

    <Label text="Registro de libros"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <GridPane hgap="10.0" vgap="10.0">
        <Label text="Título:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField fx:id="txtTitulo"
                   promptText="Título del libro"
                   prefWidth="220.0"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <Label text="Autor:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <TextField fx:id="txtAutor"
                   promptText="Autor del libro"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <Label text="Año:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <TextField fx:id="txtAnio"
                   promptText="Año de publicación"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>

        <Label text="Precio:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <TextField fx:id="txtPrecio"
                   promptText="Precio del libro"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>
    </GridPane>

    <HBox spacing="10.0">
        <Button text="Guardar libro"
                onAction="#guardarLibro"/>

        <Button text="Cargar libros"
                onAction="#cargarLibros"/>
    </HBox>

    <TableView fx:id="tablaLibros"
               prefHeight="350.0"
               VBox.vgrow="ALWAYS">

        <placeholder>
            <Label text="Tabla sin contenido"/>
        </placeholder>

        <columns>
            <TableColumn fx:id="colId"
                         text="ID"
                         prefWidth="60.0"/>

            <TableColumn fx:id="colTitulo"
                         text="Título"
                         prefWidth="240.0"/>

            <TableColumn fx:id="colAutor"
                         text="Autor"
                         prefWidth="220.0"/>

            <TableColumn fx:id="colAnio"
                         text="Año"
                         prefWidth="90.0"/>

            <TableColumn fx:id="colPrecio"
                         text="Precio"
                         prefWidth="100.0"/>
        </columns>
    </TableView>

</VBox>